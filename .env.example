# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Genera uno con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# IP real del cliente (rate limits y bloqueo de login):
#  - PROXY_COUNT = nº de proxies de confianza que AÑADEN a X-Forwarded-For (Render = 1).
#  - BEHIND_CLOUDFLARE=True si el tráfico pasa por el proxy de Cloudflare (usa CF-Connecting-IP).
PROXY_COUNT=1
BEHIND_CLOUDFLARE=False

# Base de datos (Supabase / PostgreSQL)
DATABASE_URL=

# Cloudflare R2 (archivos subidos)
USE_CLOUD_STORAGE=True
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_CUSTOM_DOMAIN=

# Supabase Realtime (la anon key es pública; los permisos los limita la migración foro 0021)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Correo
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Redis (caché y rate limits)
REDIS_URL=

# Moderación (opcional)
REPORTES_PARA_OCULTAR=8
REPORTES_ANTIGUEDAD_DIAS=3
